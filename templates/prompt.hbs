<div class="spd-prompt-body">
  <p>{{text}}</p>
  <div class="spd-actions">
    <button type="button" class="spd-primary" data-action="help"><i class="fa-solid fa-stethoscope" aria-hidden="true"></i>{{localize "SPD.Prompt.help"}}</button>
    <button type="button" data-action="later">{{localize "SPD.Prompt.later"}}</button>
    <button type="button" data-action="never">{{localize "SPD.Prompt.never"}}</button>
  </div>
</div>
